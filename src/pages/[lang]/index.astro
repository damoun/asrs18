---
import Layout from '../../layouts/Layout.astro';
import { ui, questions, type Language } from '../../data/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'es' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pt' } },
  ];
}

const { lang } = Astro.params as { lang: Language };
const t = ui[lang];
const localeQuestions = questions[lang];
---

<Layout title={t['site.title']} description={t['site.description']} lang={lang}>
	<section>
		<h2>{t['site.title']}</h2>
		<p>{t['assessment.instructions']}</p>
		
		<form id="asrs-form">
			{localeQuestions.map((question, index) => (
				<>
					<div class="question-container" data-index={index}>
						<p><strong>{index + 1}. {question}</strong></p>
						<fieldset>
							<div class="grid">
								<label>
									<input type="radio" name={`q${index}`} value="0" required />
									{t['options.never']}
								</label>
								<label>
									<input type="radio" name={`q${index}`} value="1" />
									{t['options.rarely']}
								</label>
								<label>
									<input type="radio" name={`q${index}`} value="2" />
									{t['options.sometimes']}
								</label>
								<label>
									<input type="radio" name={`q${index}`} value="3" />
									{t['options.often']}
								</label>
								<label>
									<input type="radio" name={`q${index}`} value="4" />
									{t['options.veryOften']}
								</label>
							</div>
						</fieldset>
					</div>
					{index === 5 && (
						<div class="part-divider">
							<hr />
							<span>{t['assessment.partB']}</span>
						</div>
					)}
				</>
			))}
			
			<button type="submit">{t['assessment.submit']}</button>
		</form>
	</section>

	<dialog id="result-modal">
		<article>
			<header>
				<button aria-label="Close" rel="prev" id="close-modal"></button>
				<h3>{t['results.title']}</h3>
			</header>
			<div id="result-content">
				<!-- Results will be injected here -->
			</div>
			<footer>
				<p><small>{t['results.disclaimer']}</small></p>
				<button id="share-button">Share Result</button>
			</footer>
		</article>
	</dialog>

	<style>
		.question-container {
			margin-bottom: 2rem;
			padding-bottom: 1rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
		}
		.question-container:last-of-type {
			border-bottom: none;
		}
		fieldset {
			border: none;
			padding: 0;
			margin: 0;
		}
		.grid {
			grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
		}
		.part-divider {
			position: relative;
			text-align: center;
			margin: 4rem 0;
		}
		.part-divider hr {
			margin: 0;
			border-top: 2px solid var(--pico-muted-border-color);
		}
		.part-divider span {
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			background: var(--pico-background-color);
			padding: 0 1.5rem;
			font-weight: bold;
			color: var(--pico-primary);
			text-transform: uppercase;
			letter-spacing: 0.1rem;
		}
	</style>
</Layout>

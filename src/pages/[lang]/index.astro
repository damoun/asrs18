---
import Layout from '../../layouts/Layout.astro';
import { ui, questions, type Language } from '../../data/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'es' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pt' } },
  ];
}

const { lang } = Astro.params as { lang: Language };
const t = ui[lang];
const localeQuestions = questions[lang];
---

<Layout title={t['site.title']} description={t['site.description']} lang={lang}>
	<section>
		<hgroup>
			<h2>{t['site.title']}</h2>
			<p class="intro-text">{t['assessment.instructions']}</p>
		</hgroup>
		
		<form id="asrs-form">
			{localeQuestions.map((question, index) => (
				<>
					<div class="question-container" data-index={index}>
						<p class="question-text">
							<span class="question-number">{index + 1}.</span> {question}
						</p>
						<fieldset>
							<div class="grid">
								<label>
									<input type="radio" name={`q${index}`} value="0" required />
									{t['options.never']}
								</label>
								<label>
									<input type="radio" name={`q${index}`} value="1" />
									{t['options.rarely']}
								</label>
								<label>
									<input type="radio" name={`q${index}`} value="2" />
									{t['options.sometimes']}
								</label>
								<label>
									<input type="radio" name={`q${index}`} value="3" />
									{t['options.often']}
								</label>
								<label>
									<input type="radio" name={`q${index}`} value="4" />
									{t['options.veryOften']}
								</label>
							</div>
						</fieldset>
					</div>
					{index === 5 && (
						<div class="part-divider">
							<hr />
							<span>{t['assessment.partB']}</span>
						</div>
					)}
				</>
			))}
			
			<button type="submit">{t['assessment.submit']}</button>
		</form>
	</section>

	<dialog id="result-modal">
		<article>
			<header>
				<button aria-label="Close" rel="prev" id="close-modal"></button>
				<h3>{t['results.title']}</h3>
			</header>
			<div id="result-content">
				<!-- Results will be injected here -->
			</div>
			<footer>
				<p><small>{t['results.disclaimer']}</small></p>
				<button id="share-button">Share Result</button>
			</footer>
		</article>
	</dialog>

	<style>
		.intro-text {
			font-style: italic;
			color: var(--pico-muted-color);
			margin-bottom: 3rem;
		}
		.question-container {
			margin-bottom: 3rem;
			padding: 1.5rem;
			background: var(--pico-card-background-color);
			border-radius: var(--pico-border-radius);
			border: 1px solid var(--pico-muted-border-color);
		}
		.question-text {
			font-size: 1.1rem;
			font-weight: 600;
			margin-bottom: 1rem;
		}
		.question-number {
			color: var(--pico-primary);
			margin-right: 0.5rem;
		}
		fieldset {
			border: none;
			padding: 0;
			margin: 0;
		}
		.grid {
			grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
		}
		.part-divider {
			position: relative;
			text-align: center;
			margin: 5rem 0;
		}
		.part-divider hr {
			margin: 0;
			border-top: 2px solid var(--pico-primary);
			opacity: 0.3;
		}
		.part-divider span {
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			background: var(--pico-background-color);
			padding: 0 2rem;
			font-weight: 800;
			color: var(--pico-primary);
			text-transform: uppercase;
			letter-spacing: 0.2rem;
		}
	</style>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { ui, questions, type Language } from '../../data/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'es' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pt' } },
  ];
}

const { lang } = Astro.params as { lang: Language };
const t = ui[lang];
const localeQuestions = questions[lang];
---

<Layout title={t['site.title']} description={t['site.description']} lang={lang}>
	<section>
		<hgroup>
			<h2>{t['site.title']}</h2>
			<p class="intro-text">{t['assessment.instructions']}</p>
		</hgroup>
		
		<form id="asrs-form">
			{localeQuestions.map((question, index) => (
				<>
					<div class="question-container" data-index={index}>
						<p class="question-text">
							<span class="question-number">{index + 1}.</span> {question}
						</p>
						<fieldset>
							<div class="grid">
								<label>
									<input type="radio" name={`q${index}`} value="0" class="option-input" required={index < 6} />
									<span class="option-label">{t['options.never']}</span>
								</label>
								<label>
									<input type="radio" name={`q${index}`} value="1" class="option-input" />
									<span class="option-label">{t['options.rarely']}</span>
								</label>
								<label>
									<input type="radio" name={`q${index}`} value="2" class="option-input" />
									<span class="option-label">{t['options.sometimes']}</span>
								</label>
								<label>
									<input type="radio" name={`q${index}`} value="3" class="option-input" />
									<span class="option-label">{t['options.often']}</span>
								</label>
								<label>
									<input type="radio" name={`q${index}`} value="4" class="option-input" />
									<span class="option-label">{t['options.veryOften']}</span>
								</label>
							</div>
						</fieldset>

					</div>
					{index === 5 && (
						<div class="part-divider">
							<hr />
							<span>{t['assessment.partB']}</span>
						</div>
					)}
				</>
			))}
			
			<button type="submit">{t['assessment.submit']}</button>
		</form>
	</section>

	<dialog id="result-modal">
		<article>
			<header>
				<button aria-label="Close" rel="prev" id="close-modal"></button>
				<h3 id="result-title"></h3>
			</header>
			<div id="result-content">
				<h4 id="result-level"></h4>
				<div class="result-scores">
					<div class="score-card">
						<h5>{t['results.partA.title']}</h5>
						<p id="result-score-info-A"></p>
					</div>
					<div class="score-card">
						<h5>{t['results.partB.title']}</h5>
						<p id="result-score-info-B"></p>
					</div>
				</div>
				<p id="result-interpretation"></p>
				<p class="practitioner-note">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
					<small>{t['results.practitioner_note']}</small>
				</p>
			</div>
			<footer>
				<p><small>{t['results.disclaimer']}</small></p>
				<button id="share-button">{t['results.share']}</button>
			</footer>
		</article>
	</dialog>

	<script is:inline define:vars={{ lang, t }}>
		const form = document.getElementById('asrs-form');
		const modal = document.getElementById('result-modal');
		const closeModal = document.getElementById('close-modal');
		
		const resultTitle = document.getElementById('result-title');
		const resultLevel = document.getElementById('result-level');
		const resultScoreInfoA = document.getElementById('result-score-info-A');
		const resultScoreInfoB = document.getElementById('result-score-info-B');
		const resultInterpretation = document.getElementById('result-interpretation');

		// ASRS v1.1 Shaded Boxes Logic
		// Part A: Q1-Q3 (Sometimes, Often, Very Often), Q4-Q6 (Often, Very Often)
		// Part B: Q7, Q8, Q9 (Sometimes, Often, Very Often), Q10, Q11 (Often, Very Often), 
		//         Q12, Q13 (Sometimes, Often, Very Often), Q14 (Often, Very Often), 
		//         Q15 (Sometimes, Often, Very Often), Q16 (Often, Very Often),
		//         Q17, Q18 (Often, Very Often)
		const shadedThresholds = [
			2, 2, 2, 3, 3, 3, // Part A (0-5)
			2, 2, 2, 3, 3, 2, 2, 3, 2, 3, 3, 3 // Part B (6-17)
		];

		form?.addEventListener('submit', (e) => {
			e.preventDefault();
			const formData = new FormData(form);
			let partAScore = 0;
			let partBScore = 0;

			for (let i = 0; i < 18; i++) {
				const value = parseInt(formData.get(`q${i}`));
				if (value >= shadedThresholds[i]) {
					if (i < 6) {
						partAScore++;
					} else {
						partBScore++;
					}
				}
			}

			// Prepare Results
			resultTitle.textContent = t['results.title'];
			resultScoreInfoA.textContent = t['results.score_info'].replace('{score}', partAScore);
			resultScoreInfoB.textContent = t['results.score_info_partB'].replace('{score}', partBScore);

			if (partAScore >= 4) {
				resultLevel.textContent = t['results.level.high'];
				resultInterpretation.textContent = t['results.interpretation.high'];
				resultLevel.style.color = 'var(--pico-primary)';
			} else {
				resultLevel.textContent = t['results.level.low'];
				resultInterpretation.textContent = t['results.interpretation.low'];
				resultLevel.style.color = 'inherit';
			}

			modal.showModal();
		});

		closeModal?.addEventListener('click', () => {
			modal.close();
		});

		// Close modal on click outside
		modal?.addEventListener('click', (e) => {
			if (e.target === modal) modal.close();
		});
	</script>

	<style>
		.intro-text {
			font-style: italic;
			color: var(--pico-muted-color);
			margin-bottom: 3rem;
		}
		.question-container {
			margin-bottom: 3rem;
			padding: 1.5rem;
			background: var(--pico-card-background-color);
			border-radius: var(--pico-border-radius);
			border: 1px solid var(--pico-muted-border-color);
		}
		.question-text {
			font-size: 1.1rem;
			font-weight: 600;
			margin-bottom: 1rem;
		}
		.question-number {
			color: var(--pico-primary);
			margin-right: 0.5rem;
		}
		fieldset {
			border: none;
			padding: 0;
			margin: 0;
		}
		.grid {
			display: flex;
			flex-wrap: nowrap;
			gap: 0;
			border: 1px solid var(--pico-muted-border-color);
			border-radius: var(--pico-border-radius);
			overflow: hidden;
			margin-bottom: var(--pico-spacing);
			padding: 0;
		}
		.grid label {
			flex: 1 1 0;
			width: 20%;
			margin: 0 !important;
			padding: 0 !important;
			display: flex;
		}
		@media (max-width: 600px) {
			.grid {
				flex-direction: column;
			}
			.grid label {
				width: 100%;
			}
		}
		.option-label {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 100%;
			min-height: 4rem;
			padding: 0.5rem;
			text-align: center;
			background: var(--pico-secondary-background);
			border: none;
			border-right: 1px solid var(--pico-muted-border-color);
			border-bottom: 1px solid var(--pico-muted-border-color);
			border-radius: 0;
			cursor: pointer;
			transition: all 0.2s ease;
			font-size: 0.85rem;
			margin: 0;
			line-height: 1.2;
		}
		@media (min-width: 601px) {
			.option-label {
				border-bottom: none;
			}
			label:last-child .option-label {
				border-right: none;
			}
		}
		@media (max-width: 600px) {
			.option-label {
				border-right: none;
			}
			label:last-child .option-label {
				border-bottom: none;
			}
		}
		.option-label:hover {
			background: var(--pico-secondary-hover-background);
		}
		.option-input {
			position: absolute;
			opacity: 0;
			width: 0;
			height: 0;
		}
		.option-input:checked + .option-label {
			background: var(--pico-primary-background);
			color: var(--pico-primary-inverse);
			border-color: var(--pico-primary-border);
		}
		.option-input:focus-visible + .option-label {
			outline: 2px solid var(--pico-primary);
			outline-offset: 2px;
		}
		.part-divider {
			position: relative;
			text-align: center;
			margin: 5rem 0;
		}
		.part-divider hr {
			margin: 0;
			border-top: 2px solid var(--pico-primary);
			opacity: 0.3;
		}
		.part-divider span {
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			background: var(--pico-background-color);
			padding: 0 2rem;
			font-weight: 800;
			color: var(--pico-primary);
			text-transform: uppercase;
			letter-spacing: 0.2rem;
		}
		.result-scores {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1rem;
			margin: 1.5rem 0;
		}
		.score-card {
			background: var(--pico-secondary-background);
			padding: 1rem;
			border-radius: var(--pico-border-radius);
			text-align: center;
		}
		.score-card h5 {
			margin-bottom: 0.5rem;
			font-size: 0.9rem;
			color: var(--pico-muted-color);
		}
		.score-card p {
			margin-bottom: 0;
			font-weight: bold;
		}
		#result-level {
			text-align: center;
			margin-bottom: 0.5rem;
		}
		#result-interpretation {
			font-size: 0.95rem;
			line-height: 1.5;
			border-top: 1px solid var(--pico-muted-border-color);
			padding-top: 1rem;
			margin-bottom: 1.5rem;
		}
		.practitioner-note {
			display: flex;
			gap: 0.75rem;
			align-items: flex-start;
			padding: 1rem;
			background: var(--pico-ins-color);
			color: var(--pico-primary-inverse);
			border-radius: var(--pico-border-radius);
			margin-bottom: 0;
		}
		.practitioner-note svg {
			flex-shrink: 0;
			margin-top: 0.1rem;
		}
		.practitioner-note small {
			line-height: 1.4;
			font-weight: 500;
		}
	</style>
</Layout>
